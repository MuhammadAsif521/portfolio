{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "2a364087-b78b-46a8-8553-819d13b2789f"
  },
  "newProjectRoot": "projects",
  "projects": {
    "website": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/website",
      "sourceRoot": "projects/website/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/website/src/main.ts",
            "tsConfig": "projects/website/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/lib"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shared/src/lib/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/intl-tel-input/dist/img",
                "output": "assets/intl-tel-input/img"
              },
              {
                "glob": "robots.txt",
                "input": "projects/website/src",
                "output": "/"
              },
              {
                "glob": "llm.txt",
                "input": "projects/website/src",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/urbanist/index.css",
              "projects/shared/src/lib/styles.scss",
              "node_modules/intl-tel-input/dist/css/intlTelInput.css"
            ],
            "server": "projects/website/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "asifdev.com"
              ]
            },
            "ssr": {
              "entry": "projects/website/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "website:build:production"
            },
            "development": {
              "buildTarget": "website:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "projects/website/vitest.config.ts"
          }
        }
      }
    },
    "cusadmin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/cusadmin",
      "sourceRoot": "projects/cusadmin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/cusadmin/src/main.ts",
            "tsConfig": "projects/cusadmin/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/lib"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shared/src/lib/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/intl-tel-input/dist/img",
                "output": "assets/intl-tel-input/img"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/urbanist/index.css",
              "projects/shared/src/lib/styles.scss",
              "node_modules/intl-tel-input/dist/css/intlTelInput.css"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/cusadmin/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cusadmin:build:production"
            },
            "development": {
              "buildTarget": "cusadmin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json"
          }
        }
      }
    }
  }
}