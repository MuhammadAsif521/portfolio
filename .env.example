# SSR server settings for the website (copy to .env; .env is git-ignored). Read on the server only.

# Must equal SSR_API_KEY in portfolio-node/.env (lets server-rendered pages call the public API).
SSR_API_KEY=

# portfolio-node as the SSR server reaches it. Local dev: the backend on port 3000.
# Docker: http://portfolio-node:3000/api/v1
API_INTERNAL_URL=http://localhost:3000/api/v1

# Production host names the SSR server answers for (comma-separated).
# ALLOWED_HOSTS=asifdev.com,www.asifdev.com
