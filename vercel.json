{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/website/browser",
  "functions": {
    "api/render.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "dist/website/server/**"
    }
  },
  "redirects": [{ "source": "/cusadmin", "destination": "/cusadmin/", "permanent": true }],
  "rewrites": [
    { "source": "/cusadmin/:path*", "destination": "/cusadmin/index.html" },
    { "source": "/(.*)", "destination": "/api/render" }
  ]
}
